# secrets — never commit
.env
.env.local
*.pem
*.key

# build artefacts
node_modules/
dist/
.astro/
__pycache__/
*.pyc

# generated output — GitHub Actions builds the published site from source
public_html/
logs/

# runtime state
curator/state/

# NOTE: site/src/content/posts/*.md is deliberately NOT ignored.
# Curated Markdown is the payload the homelab pushes; GitHub Actions builds the
# site from it. Ignoring it made `git diff --cached` always empty, so every
# cycle reported "nothing to push" and nothing ever reached production.
