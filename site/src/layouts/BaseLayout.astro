---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Technology news ranked by a deterministic heuristic. No model, no noise.' } = Astro.props;
const year = new Date().getFullYear();
// Absolute, derived from `site` (which comes from public/CNAME).
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:8080').href;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="signal.log" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#08090a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="signal.log" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="bg-glow" aria-hidden="true"></div>

    <header class="fixed top-0 z-50 h-[68px] w-full border-b border-line bg-bg/70 backdrop-blur-[14px]">
      <nav class="mx-auto flex h-full max-w-[1020px] items-center justify-between px-6">
        <a href="/" class="font-mono text-[1.15rem] font-semibold text-ink no-underline">
          signal<span class="text-accent">.</span>log
        </a>
        <ul class="hidden list-none gap-8 sm:flex">
          <li><a href="/" class="navlink font-mono text-[0.85rem] text-dim no-underline">index</a></li>
          <li><a href="/#feed" class="navlink font-mono text-[0.85rem] text-dim no-underline">feed</a></li>
          <li><a href="/#about" class="navlink font-mono text-[0.85rem] text-dim no-underline">about</a></li>
        </ul>
        <span class="flex items-center gap-2 rounded-lg border border-line px-3 py-[0.45rem] font-mono text-[0.75rem] text-dim">
          <span class="relative flex h-[6px] w-[6px]">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-70"></span>
            <span class="relative inline-flex h-[6px] w-[6px] rounded-full bg-accent"></span>
          </span>
          auto-curated
        </span>
      </nav>
    </header>

    <main class="mx-auto max-w-[900px] px-6 pt-[130px] pb-[70px]">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-[900px] flex-wrap items-center justify-between gap-3 px-6 py-8 font-mono text-[0.78rem] text-faint">
        <span>&copy; {year} signal.log</span>
        <span class="flex items-center gap-4">
          <a href="/rss.xml" class="text-faint no-underline transition-colors duration-300 hover:text-accent">rss</a>
          <span>astro &middot; deterministic ranking &middot; built in ci</span>
        </span>
      </div>
    </footer>

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
