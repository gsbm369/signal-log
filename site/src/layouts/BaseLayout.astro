---
import { createHash } from 'node:crypto';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { CATEGORY_LABELS } from '../categories';

interface Props {
  title: string;
  description?: string;
  /** Per-page social image. Falls back to the site card. */
  ogImage?: string;
  /** Category hue for chrome that should take the page's colour (the article
   *  reading-progress bar). */
  cat?: string;
}

const {
  title,
  description = 'Technology news ranked by a deterministic heuristic. No model, no noise.',
  ogImage,
  cat,
} = Astro.props;
const year = new Date().getFullYear();
// Absolute, derived from `site` (which comes from public/CNAME).
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:8080').href;

// The one script this site runs. Kept as a string so its CSP hash can be
// computed from the exact bytes that ship — a hash that drifts from the script
// is a control that silently stops applying, which is the failure mode this
// project keeps finding.
const revealScript = `const io = new IntersectionObserver(
  (entries) => {
    for (const e of entries) {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }
  },
  { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
);
document.querySelectorAll('.reveal').forEach((el) => io.observe(el));`;

const scriptHash = `'sha256-${createHash('sha256').update(revealScript).digest('base64')}'`;

// Content-Security-Policy, scoped to what this site actually loads:
//   img-src         widened to https: — story thumbnails come from each
//                   publisher's own CDN (Ars, Verge, Polygon, BBC, ...), and
//                   the list is not knowable at build time. Narrower would
//                   mean proxying every image through this origin, which is
//                   the better long-term answer and is noted in the README.
//   self            its own CSS, favicon and RSS
//   fonts.googleapis.com   the Google Fonts stylesheet
//   fonts.gstatic.com      the font files that stylesheet pulls
// Outbound <a href> links to source articles are navigation, not resource
// loads, so they need no allowance.
//
// script-src carries a hash rather than 'unsafe-inline' — there is exactly one
// script and its bytes are known at build time.
//
// style-src no longer needs 'unsafe-inline'. The heat meters, logo grid and
// palette swatches used to set ~165 inline `style` attributes per page, and
// hashes do not apply to style attributes. Those are now driven by CSS classes
// and a data-bars attribute, so the allowance was removed rather than
// documented. Verified against the built output: zero style attributes.
//
// frame-ancestors is ABSENT and cannot be added: it is ignored in a meta tag
// and can only be delivered as a real header, which GitHub Pages does not
// allow. See the README — clickjacking protection is unavailable on this host.
// Absolute, because every consumer of og:image — WhatsApp, Slack, iMessage,
// Discord — requires a fully-qualified URL and silently shows nothing for a
// relative one.
const ogUrl = new URL(ogImage ?? '/og-card.png', Astro.site ?? 'http://localhost:8080').href;

const csp = [
  "default-src 'self'",
  `script-src 'self' ${scriptHash}`,
  "style-src 'self' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data: https:",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
  "frame-src 'none'",
  'upgrade-insecure-requests',
].join('; ');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="signal.log" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="signal.log — technology news, deterministically ranked" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0e1116" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="signal.log" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;700&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body data-cat={cat}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] btn btn--primary">Skip to content</a>

    <header class="topbar">
      <nav class="wrap flex h-full items-center justify-between gap-6" aria-label="Primary">
        <a href="/" class="wordmark" aria-label="signal.log — home">
          <Logo size={26} class="shrink-0 text-accent" />
          <span>signal<span class="text-accent">.</span>log</span>
        </a>
        <ul class="hidden list-none items-center gap-7 md:flex">
          <li><a href="/#feed" class="navlink">Latest</a></li>
          <li><a href="/#shelves" class="navlink">Sections</a></li>
          <li><a href="/#about" class="navlink">How it works</a></li>
        </ul>
        <a href="/#subscribe" class="btn btn--primary">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36ZM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44Zm0 5.66A9.9 9.9 0 0 1 13.9 20h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>
          Subscribe
        </a>
      </nav>
    </header>

    <main id="main" class="pt-[60px] pb-20">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <a href="/" class="wordmark text-[1.5rem]">
            <Logo size={30} class="shrink-0 text-accent" />
            <span>signal<span class="text-accent">.</span>log</span>
          </a>
          <p class="mt-4 max-w-[36ch] font-serif text-[1.08rem] italic leading-[1.5] text-dim">
            An engineering briefing, rebuilt every few hours. Ranked in the open &mdash; no model decides what appears.
          </p>
          <a href="/rss.xml" class="btn btn--ghost mt-6">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36ZM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44Zm0 5.66A9.9 9.9 0 0 1 13.9 20h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>
            RSS feed
          </a>
        </div>
        <div>
          <h2 class="foot-h">Sections</h2>
          <ul class="mt-4 grid list-none gap-2.5">
            {Object.entries(CATEGORY_LABELS).map(([c, label]) => (
              <li data-cat={c}><a href={`/#${c}`} class="foot-link"><span class="dot" />{label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="foot-h">The issue</h2>
          <ul class="mt-4 grid list-none gap-2.5">
            <li><a href="/#feed" class="foot-link">Top stories</a></li>
            <li><a href="/#about" class="foot-link">How it works</a></li>
            <li><a href="/rss.xml" class="foot-link">Subscribe via RSS</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-rule">
        <div class="wrap flex flex-wrap items-center justify-between gap-3 py-6 font-mono text-[0.72rem] text-faint">
          <span>&copy; {year} signal.log</span>
          <span>astro &middot; deterministic ranking &middot; built in ci</span>
        </div>
      </div>
    </footer>

    <script type="module" is:inline set:html={revealScript}></script>
  </body>
</html>
