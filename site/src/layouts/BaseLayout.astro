---
import { createHash } from 'node:crypto';
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Technology news ranked by a deterministic heuristic. No model, no noise.' } = Astro.props;
const year = new Date().getFullYear();
// Absolute, derived from `site` (which comes from public/CNAME).
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:8080').href;

// The one script this site runs. Kept as a string so its CSP hash can be
// computed from the exact bytes that ship — a hash that drifts from the script
// is a control that silently stops applying, which is the failure mode this
// project keeps finding.
const revealScript = `const io = new IntersectionObserver(
  (entries) => {
    for (const e of entries) {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }
  },
  { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
);
document.querySelectorAll('.reveal').forEach((el) => io.observe(el));`;

const scriptHash = `'sha256-${createHash('sha256').update(revealScript).digest('base64')}'`;

// Content-Security-Policy, scoped to what this site actually loads:
//   img-src         widened to https: — story thumbnails come from each
//                   publisher's own CDN (Ars, Verge, Polygon, BBC, ...), and
//                   the list is not knowable at build time. Narrower would
//                   mean proxying every image through this origin, which is
//                   the better long-term answer and is noted in the README.
//   self            its own CSS, favicon and RSS
//   fonts.googleapis.com   the Google Fonts stylesheet
//   fonts.gstatic.com      the font files that stylesheet pulls
// Outbound <a href> links to source articles are navigation, not resource
// loads, so they need no allowance.
//
// script-src carries a hash rather than 'unsafe-inline' — there is exactly one
// script and its bytes are known at build time.
//
// style-src no longer needs 'unsafe-inline'. The heat meters, logo grid and
// palette swatches used to set ~165 inline `style` attributes per page, and
// hashes do not apply to style attributes. Those are now driven by CSS classes
// and a data-bars attribute, so the allowance was removed rather than
// documented. Verified against the built output: zero style attributes.
//
// frame-ancestors is ABSENT and cannot be added: it is ignored in a meta tag
// and can only be delivered as a real header, which GitHub Pages does not
// allow. See the README — clickjacking protection is unavailable on this host.
const csp = [
  "default-src 'self'",
  `script-src 'self' ${scriptHash}`,
  "style-src 'self' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data: https:",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
  "frame-src 'none'",
  'upgrade-insecure-requests',
].join('; ');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="signal.log" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0e1116" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="signal.log" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="fixed top-0 z-50 h-[56px] w-full border-b border-rule bg-bg">
      <nav class="mx-auto flex h-full max-w-[760px] items-center justify-between px-5">
        <a href="/" class="flex items-center gap-2.5 font-mono text-[1.1rem] font-semibold text-ink no-underline">
          <Logo size={24} class="shrink-0 text-accent" />
          signal<span class="text-accent">.</span>log
        </a>
        <ul class="hidden list-none gap-8 sm:flex">
          <li><a href="/" class="navlink font-mono text-[0.85rem] text-dim no-underline">index</a></li>
          <li><a href="/#feed" class="navlink font-mono text-[0.85rem] text-dim no-underline">feed</a></li>
          <li><a href="/#about" class="navlink font-mono text-[0.85rem] text-dim no-underline">about</a></li>
        </ul>
        <span class="flex items-center gap-2 rounded-lg border border-rule px-3 py-[0.45rem] font-mono text-[0.75rem] text-dim">
          <span class="relative flex h-[6px] w-[6px]">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-70"></span>
            <span class="relative inline-flex h-[6px] w-[6px] rounded-full bg-accent"></span>
          </span>
          auto-curated
        </span>
      </nav>
    </header>

    <main class="mx-auto max-w-[760px] px-5 pt-[96px] pb-16">
      <slot />
    </main>

    <footer class="border-t border-rule">
      <div class="mx-auto flex max-w-[760px] flex-wrap items-center justify-between gap-3 px-5 py-7 font-mono text-[0.78rem] text-faint">
        <span>&copy; {year} signal.log</span>
        <span class="flex items-center gap-4">
          <a href="/rss.xml" class="text-faint no-underline transition-colors duration-300 hover:text-accent">rss</a>
          <span>astro &middot; deterministic ranking &middot; built in ci</span>
        </span>
      </div>
    </footer>

    <script type="module" is:inline set:html={revealScript}></script>
  </body>
</html>
