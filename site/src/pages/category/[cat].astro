---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { freshnessOf, byOrder } from '../../freshness';
import { CATEGORY_LABELS } from '../../categories';

/* Every fresh story in one category, in the front page's order. This is where
   a section's "+N more" link lands. Same 7-day policy as the front page — the
   publish gate (check_freshness.py) parses these pages too. */
export const getStaticPaths: GetStaticPaths = () =>
  Object.entries(CATEGORY_LABELS).map(([cat, label]) => ({ params: { cat }, props: { label } }));

const { cat } = Astro.params;
const { label } = Astro.props;
const items = (await getCollection('posts'))
  .filter((p) => (p.data.category ?? 'aggregators') === cat && freshnessOf(p.data.pubDate) !== 'stale')
  .sort(byOrder);
const today = items.filter((p) => freshnessOf(p.data.pubDate) === 'today').length;
---

<BaseLayout title={`${label} — signal.log`} description={`Every ${label} story from the last seven days, ranked.`}>
  <a href="/" class="inline-flex items-center gap-2 font-mono text-[0.8rem] text-faint no-underline transition-colors duration-300 hover:text-accent">
    &larr; index
  </a>
  <section class="mt-7" data-category-page={cat}>
    <h1 class="font-mono text-[0.9rem] uppercase tracking-[0.14em]" data-cat={cat}>{label}</h1>
    <p class="section-count font-mono text-[0.64rem] text-faint">
      {today} today · {items.length - today} this week · {items.length} stories
    </p>
    <div class="mt-3">
      {items.length === 0 ? (
        <p class="section-empty">No new posts this week.</p>
      ) : (
        items.map((post, i) => <PostCard post={post} index={i} variant="row" section={`page-${cat}`} />)
      )}
    </div>
  </section>
</BaseLayout>
