---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { freshnessOf, byOrder } from '../../freshness';
import { CATEGORY_LABELS, CATEGORY_BLURBS } from '../../categories';

/* Every fresh story in one category, in the front page's order. This is where
   a section's "+N more" link lands. Same 7-day policy as the front page — the
   publish gate (check_freshness.py) parses these pages too. */
export const getStaticPaths: GetStaticPaths = () =>
  Object.entries(CATEGORY_LABELS).map(([cat, label]) => ({ params: { cat }, props: { label } }));

const { cat } = Astro.params;
const { label } = Astro.props;
const items = (await getCollection('posts'))
  .filter((p) => (p.data.category ?? 'aggregators') === cat && freshnessOf(p.data.pubDate) !== 'stale')
  .sort(byOrder);
const today = items.filter((p) => freshnessOf(p.data.pubDate) === 'today').length;
---

<BaseLayout title={`${label} — signal.log`} description={`Every ${label} story from the last seven days, ranked.`}>
  <section class="wrap pt-10 sm:pt-14" data-category-page={cat} data-cat={cat}>
    <nav class="flex items-center gap-2 font-mono text-[0.74rem] text-faint" aria-label="Breadcrumb">
      <a href="/" class="text-faint no-underline transition-colors hover:text-ink">signal.log</a>
      <span aria-hidden="true">/</span>
      <span class="kicker">{label}</span>
    </nav>
    <h1 class="chapter-title mt-6 text-[clamp(2rem,5vw,3rem)]" data-cat={cat}><span class="dot" />{label}</h1>
    {CATEGORY_BLURBS[cat] && <p class="chapter-blurb mt-2">{CATEGORY_BLURBS[cat]}</p>}
    <p class="section-count mt-4 font-mono text-[0.7rem] text-faint">
      {today} today · {items.length - today} this week · {items.length} stories
    </p>
    <div class="mt-8 grid gap-1 md:grid-cols-2 md:gap-x-6">
      {items.length === 0 ? (
        <p class="section-empty">No new posts this week.</p>
      ) : (
        items.map((post, i) => <PostCard post={post} index={i} variant="row" section={`page-${cat}`} />)
      )}
    </div>
  </section>
</BaseLayout>
