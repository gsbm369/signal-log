---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { freshnessOf, ageHours, cycleStart, byOrder } from '../freshness';
import { CATEGORY_LABELS, CATEGORY_BLURBS } from '../categories';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

/* Seven peer categories, no spine.
 *
 * The old layout had one category ("tech") that owned the hero and the cards,
 * and three small shelves. That shape does not survive the newsletter pivot:
 * there is no "tech" any more, and nothing replenished it, so the hero rendered
 * "nothing ranked yet" while 196 of 200 posts sat unreachable below it.
 *
 * The obvious minimal fix — promote `aggregators` into the vacant spine — was
 * rejected on measurement. aggregators holds 11 posts at the LOWEST trust
 * weights in the config (0.70-0.75), deliberately, because a Hacker News
 * headline is not what this publication leads on. Handing it the hero would
 * have inverted the editorial policy the weights exist to express.
 *
 * So the lead is drawn by SCORE across every category. The ranker has already
 * decided which item is best; the page just stops arguing with it. */
/* Section order and labels live in site/src/categories.ts (SECTION_ORDER),
   shared with the per-category pages. */
type Category = string;
const CATEGORY_ORDER = Object.keys(CATEGORY_LABELS) as Category[];

const categoryOf = (p: (typeof posts)[number]) =>
  (p.data.category ?? 'aggregators') as Category;

/* ------------------------------------------------------------------------ *
 * FRESHNESS POLICY (owner, 2026-09-18). Evergreen retired.
 *
 *   today      age <= 24h       this week  age <= 7d       older  never shown
 *
 * The curator already prunes anything past seven days, so `stale` should be
 * empty here. It is filtered anyway: the page must not depend on the pruner
 * having run, and the publish gate independently refuses to ship a card that
 * is over the limit.
 * ------------------------------------------------------------------------ */
/* ------------------------------------------------------------------------ *
 * SELECTION — implemented to the owner's reviewed reference, 2026-09-18.
 *
 *   tier   today if age <= 24h, week if age <= 7d, otherwise EXCLUDED
 *          (age = sample time - AUTHOR date)
 *   order  today before week; within a tier, the curator's score, best first
 *   fold   AT MOST ONE STORY PER SOURCE, 5 slots. Walk "today" by order and
 *          skip any story whose source already holds a fold slot; if that
 *          leaves the fold short, keep walking into "this week" under the same
 *          rule. (Owner, 2026-09-18: the reference omitted the source rule, and
 *          AWS Architecture took 3 of 5 slots on the live page.)
 *   section(cat), fixed order:
 *          pool = this category, not in the fold, not excluded; by order;
 *          at most 2 per source in a section; first 6.
 *          Never filled from another category.
 * ------------------------------------------------------------------------ */
const tierOf = (p: (typeof posts)[number]) => freshnessOf(p.data.pubDate);

const excluded = posts.filter((p) => tierOf(p) === 'stale');
const eligible = posts.filter((p) => tierOf(p) !== 'stale').sort(byOrder);
const todayCount = eligible.filter((p) => tierOf(p) === 'today').length;
const weekCount = eligible.length - todayCount;

/* `eligible` is already today-before-week, score best first, so one pass over
   it IS "today by score, then this week by score". */
const FOLD_SLOTS = 5;
const front: typeof posts = [];
const foldSources = new Set<string>();
for (const p of eligible) {
  if (front.length === FOLD_SLOTS) break;
  if (foldSources.has(p.data.source)) continue;
  foldSources.add(p.data.source);
  front.push(p);
}
const lead = front[0];
const cards = front.slice(1, 5);
const featured = new Set(front.map((p) => p.id));

const SECTION_QUOTA = 6;
const PER_SOURCE_IN_SECTION = 2;

const shelves = Object.entries(CATEGORY_LABELS).map(([key, label]) => {
  const perSource: Record<string, number> = {};
  const items: typeof posts = [];
  for (const p of eligible) {
    if (items.length === SECTION_QUOTA) break;
    if (categoryOf(p) !== key || featured.has(p.id)) continue;
    if ((perSource[p.data.source] ?? 0) >= PER_SOURCE_IN_SECTION) continue;
    perSource[p.data.source] = (perSource[p.data.source] ?? 0) + 1;
    items.push(p);
  }
  const today = items.filter((p) => tierOf(p) === 'today').length;
  /* An empty section has two causes, and they must not share a sentence: the
     category has nothing fresh, or everything fresh it has was promoted to the
     fold. "No new posts this week." is false in the second case. */
  const promoted = front.filter((p) => categoryOf(p) === key);
  const promotedToday = promoted.some((p) => tierOf(p) === 'today');
  /* "+N more": fresh stories in this category that appear nowhere on this
     page — past the 6-slot quota or over the per-source cap. The category
     page lists them all. */
  const fresh = eligible.filter((p) => categoryOf(p) === key).length;
  const more = fresh - items.length - promoted.length;
  return { key, label, items, today, week: items.length - today, promoted: promoted.length, promotedToday, more };
});

/* Masthead facts — computed from the data, never hard-coded. */
const oldestH = eligible.reduce((m, p) => Math.max(m, ageHours(p.data.pubDate)), 0);
const oldestAge =
  oldestH >= 24 ? `${Math.floor(oldestH / 24)}d ${Math.round(oldestH % 24)}h` : `${Math.round(oldestH)}h`;
const sampled = cycleStart.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
const tech = eligible;



/* Presentation-only additions for the issue layout. */
const dateline = cycleStart.toLocaleDateString('en-GB', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const blurbOf = (k: string) => CATEGORY_BLURBS[k] ?? '';
const feedUrl = new URL('/rss.xml', Astro.site ?? 'http://localhost:8080').href;
const rssIcon = 'M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36ZM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44Zm0 5.66A9.9 9.9 0 0 1 13.9 20h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z';
const pad = (n: number) => String(n).padStart(2, '0');

---

<BaseLayout
  title="signal.log — an engineering newsletter, deterministically ranked"
  description="Microsoft, system design, devops, languages, company engineering, deep dives, fintech and gaming — ranked by an open heuristic: per-category recency decay, source trust, topic relevance, deduplication. No model decides what appears."
>
  <!-- ── Masthead ─────────────────────────────────────────────── -->
  <header class="wrap pt-12 text-center sm:pt-16">
    <p class="overline">{dateline} &middot; The engineering briefing</p>
    <h1 class="masthead-title mt-5">signal<span class="text-accent">.</span>log</h1>
    <p class="masthead-tag mx-auto mt-5 max-w-[34ch]">
      The best of engineering writing this week &mdash; ranked in the open, never by a model.
    </p>
    <div class="double-rule mt-9"></div>
    <div class="stat-row">
      <span>sampled <b>{sampled}</b></span>
      <span><b>{eligible.length}</b> stories</span>
      <span><b>{todayCount}</b> today</span>
      <span><b>{weekCount}</b> this week</span>
      <span>oldest <b>{oldestAge}</b></span>
      <span data-older-than-7d={excluded.length}><b>{excluded.length}</b> older than 7 days</span>
    </div>
  </header>

  <!-- ── Section strip ────────────────────────────────────────── -->
  <nav class="strip" aria-label="Sections">
    <div class="wrap">
      <div class="strip-scroll">
        {shelves.map((shelf) => (
          <a href={`#${shelf.key}`} class="strip-link" data-cat={shelf.key}>
            <span class="dot" />{shelf.label}<span class="n">{shelf.items.length + shelf.promoted + shelf.more}</span>
          </a>
        ))}
      </div>
    </div>
  </nav>

  <!-- ── The front page ───────────────────────────────────────── -->
  <section id="feed" class="wrap mt-10">
    {
      front.length === 0 ? (
        <p class="section-empty py-16 text-center">No new posts this week.</p>
      ) : (
        <>
          <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
            <PostCard post={lead} index={0} variant="hero" section="fold" />

            <aside class="toc reveal hidden flex-col p-6 lg:flex" aria-labelledby="toc-h">
              <h2 id="toc-h" class="eyebrow">In this issue</h2>
              <nav class="mt-3 flex-1">
                {shelves.map((shelf, i) => (
                  <a href={`#${shelf.key}`} class="toc-link" data-cat={shelf.key}>
                    <span class="num">{pad(i + 1)}</span>
                    <span class="name">{shelf.label}</span>
                    <span class="count">{shelf.items.length + shelf.promoted + shelf.more}</span>
                  </a>
                ))}
              </nav>
              <a href="#subscribe" class="btn btn--ghost mt-5 w-full justify-center">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={rssIcon} /></svg>
                Get every issue
              </a>
            </aside>
          </div>

          {cards.length > 0 && (
            <>
              <h2 class="eyebrow mt-14 mb-6">Also leading</h2>
              <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                {cards.map((post, i) => (
                  <PostCard post={post} index={i + 1} variant="card" section="fold" />
                ))}
              </div>
            </>
          )}
        </>
      )
    }
  </section>

  <!-- ── Chapters ─────────────────────────────────────────────── -->
  <div id="shelves" class="wrap mt-20 grid gap-16">
    {shelves.map((shelf, i) => (
      /* Every category renders, even empty, so section order and #anchors stay
         stable from one issue to the next. data-section scopes the isolation
         test and check_selection.py: nothing in here may depend on another
         shelf, no <section> may nest inside it, and the "+N more" link and
         the empty-state line must stay INSIDE it. */
      <section class="chapter reveal" id={shelf.key} data-section={shelf.key} data-cat={shelf.key}>
        <header class="chapter-head">
          <span class="chapter-num" aria-hidden="true">{pad(i + 1)}</span>
          <h3 class="chapter-title"><span class="dot" />{shelf.label}</h3>
          <p class="chapter-blurb">{blurbOf(shelf.key)}</p>
        </header>
        <p class="section-count mb-5 font-mono text-[0.7rem] text-faint" data-count>
          {shelf.today} today · {shelf.week} this week · {shelf.items.length} of 6
        </p>
        {shelf.items.length === 0 && shelf.promoted > 0 ? (
          <p class="section-empty" data-empty="in-fold">
            <a href="#feed">{shelf.promotedToday ? "Today's" : "This week's"} {shelf.label} stories are in the headlines above.</a>
          </p>
        ) : shelf.items.length === 0 ? (
          <p class="section-empty" data-empty="none">No new posts this week.</p>
        ) : (
          <div class={`chapter-grid${shelf.items.length === 1 ? ' chapter-grid--solo' : ''}`}>
            <PostCard post={shelf.items[0]} index={0} variant="feature" section={shelf.key} />
            {shelf.items.length > 1 && (
              <div>
                {shelf.items.slice(1).map((post, j) => (
                  <PostCard post={post} index={j + 1} variant="item" section={shelf.key} />
                ))}
              </div>
            )}
          </div>
        )}
        {shelf.more > 0 && (
          <a href={`/category/${shelf.key}/`} class="section-more btn btn--ghost mt-6" data-more={shelf.more}>
            +{shelf.more} more
          </a>
        )}
      </section>
    ))}
  </div>

  <!-- ── Subscribe ────────────────────────────────────────────── -->
  <section id="subscribe" class="wrap mt-24">
    <div class="subscribe reveal grid items-center gap-8 p-8 sm:p-12 lg:grid-cols-[1.2fr_1fr]">
      <div class="relative">
        <p class="overline text-accent">Subscribe</p>
        <h2 class="mt-3 font-display text-[2rem] font-extrabold leading-[1.02] tracking-[-0.04em] text-ink sm:text-[2.6rem]">
          Never miss an issue.
        </h2>
        <p class="standfirst mt-4 max-w-[46ch]">
          Pull signal.log into any feed reader. No account, no email address, no tracking &mdash; just the ranked stories, as they land.
        </p>
      </div>
      <div class="relative flex flex-col gap-3">
        <a href="/rss.xml" class="btn btn--primary btn--lg justify-center">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={rssIcon} /></svg>
          Subscribe via RSS
        </a>
        <p class="feed-url">{feedUrl}</p>
      </div>
    </div>
  </section>

  <!-- ── Colophon ─────────────────────────────────────────────── -->
  <section id="about" class="wrap mt-24">
    <div class="double-rule"></div>
    <div class="grid gap-10 pt-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="overline">Colophon</p>
        <h2 class="mt-2 font-display text-[1.7rem] font-extrabold tracking-[-0.035em] text-ink">How this works</h2>
        <p class="mt-3 max-w-[34ch] font-serif text-[1.05rem] italic leading-[1.5] text-dim">
          Every story on this page was chosen by a rule you can read, not a model you have to trust.
        </p>
      </div>
      <div class="grid gap-8 sm:grid-cols-3">
        {
          [
            { n: '01', t: 'Collect', d: 'A Python job pulls RSS from a fixed list of feeds every few hours.' },
            { n: '02', t: 'Rank', d: 'A deterministic heuristic scores each story, drops routine digests, collapses duplicates and caps any one feed.' },
            { n: '03', t: 'Publish', d: 'Survivors become Markdown, pushed to GitHub. CI builds the issue and deploys it.' },
          ].map((s) => (
            <div>
              <span class="step-n">{s.n}</span>
              <h3 class="mt-3 font-display text-[1.1rem] font-bold text-ink">{s.t}</h3>
              <p class="mt-2 text-[0.94rem] leading-[1.6] text-dim">{s.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
