---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SectionHead from '../components/SectionHead.astro';
import Logo from '../components/Logo.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

/* Three tiers, because the ranker produces a ranking. A flat column of
   identical cards says every story matters equally, which is the one thing
   this site's output does not say. */
const lead = posts[0];
const briefs = posts.slice(1, 4);
const wire = posts.slice(4);

const sources = [...new Set(posts.map((p) => p.data.source))];
const lastRun = lead
  ? lead.data.pubDate.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })
  : '—';
---

<BaseLayout
  title="signal.log — technology news, deterministically ranked"
  description="Tech feeds ranked by an open, deterministic heuristic: recency decay, source weighting, topic relevance, deduplication. No model decides what appears."
>
  <!-- ── Masthead ─────────────────────────────────────────────── -->
  <section class="reveal in">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-line pb-8">
      <div class="flex items-center gap-4">
        <Logo size={44} class="shrink-0 text-accent" />
        <div>
          <h1 class="font-head text-[2.1rem] font-bold leading-none tracking-[-1.2px] text-ink sm:text-[2.6rem]">
            signal<span class="text-accent">.</span>log
          </h1>
          <p class="mt-2 font-mono text-[0.86rem] text-accent">tech news, minus the noise</p>
        </div>
      </div>

      <dl class="flex flex-wrap gap-x-8 gap-y-3 font-mono text-[0.76rem]">
        <div>
          <dt class="text-faint">stories</dt>
          <dd class="mt-0.5 text-[1.05rem] text-ink">{posts.length}</dd>
        </div>
        <div>
          <dt class="text-faint">sources</dt>
          <dd class="mt-0.5 text-[1.05rem] text-ink">{sources.length}</dd>
        </div>
        <div>
          <dt class="text-faint">updated</dt>
          <dd class="mt-0.5 text-[0.86rem] text-dim">{lastRun}</dd>
        </div>
      </dl>
    </div>

    <p class="mt-6 max-w-[68ch] text-[0.95rem] leading-[1.75] text-dim">
      An automated briefing. Every few hours a job pulls the major tech feeds and ranks
      them with an open, deterministic heuristic — recency decay, a narrow per-source
      weight, topic relevance read from the headline, and deduplication across sources.
      <span class="text-ink">No model decides what appears.</span> Position on this page
      follows the score: one lead, three runners-up, then the wire.
    </p>
  </section>

  <!-- ── The feed ─────────────────────────────────────────────── -->
  <section id="feed" class="mt-14">
    {
      posts.length === 0 ? (
        <div class="panel p-10 text-center">
          <p class="font-mono text-[0.9rem] text-dim">no stories yet</p>
          <p class="mt-2 font-mono text-[0.8rem] text-faint">
            the curator runs on a timer — the first batch lands within a few hours
          </p>
        </div>
      ) : (
        <>
          <PostCard post={lead} index={0} variant="lead" />

          {briefs.length > 0 && (
            <div class="mt-5 grid gap-5 sm:grid-cols-3">
              {briefs.map((post, i) => (
                <PostCard post={post} index={i + 1} variant="brief" />
              ))}
            </div>
          )}

          {wire.length > 0 && (
            <div class="mt-16">
              <div class="mb-4 flex items-baseline justify-between border-b border-line pb-3">
                <h2 class="font-mono text-[0.8rem] uppercase tracking-[0.14em] text-dim">
                  the wire
                </h2>
                <span class="font-mono text-[0.72rem] text-faint">
                  {wire.length} more, by score
                </span>
              </div>
              <div class="flex flex-col">
                {wire.map((post, i) => (
                  <PostCard post={post} index={i + 4} variant="wire" />
                ))}
              </div>
            </div>
          )}
        </>
      )
    }
  </section>

  <!-- ── How it works ─────────────────────────────────────────── -->
  <section id="about" class="mt-20 border-t border-line pt-16">
    <SectionHead idx="01" title="How this works" />
    <div class="grid gap-[1.1rem] sm:grid-cols-3">
      {
        [
          { n: '01', t: 'Collect', d: 'A Python job pulls RSS from Hacker News, TechCrunch, Ars Technica, The Verge, IEEE Spectrum and more.' },
          { n: '02', t: 'Rank', d: 'A deterministic heuristic scores each story, drops routine digests, collapses duplicates across sources, and caps any one feed.' },
          { n: '03', t: 'Publish', d: 'Survivors land as Markdown and are pushed to GitHub. Actions builds the site and deploys it to Pages.' },
        ].map((s) => (
          <div class="panel panel-hover reveal p-6">
            <span class="font-mono text-[0.75rem] text-accent">{s.n}</span>
            <h3 class="mt-2 font-head text-[1.05rem] font-semibold text-ink">{s.t}</h3>
            <p class="mt-2 text-[0.88rem] leading-[1.7] text-dim">{s.d}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
