---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Logo from '../components/Logo.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

/* Seven peer categories, no spine.
 *
 * The old layout had one category ("tech") that owned the hero and the cards,
 * and three small shelves. That shape does not survive the newsletter pivot:
 * there is no "tech" any more, and nothing replenished it, so the hero rendered
 * "nothing ranked yet" while 196 of 200 posts sat unreachable below it.
 *
 * The obvious minimal fix — promote `aggregators` into the vacant spine — was
 * rejected on measurement. aggregators holds 11 posts at the LOWEST trust
 * weights in the config (0.70-0.75), deliberately, because a Hacker News
 * headline is not what this publication leads on. Handing it the hero would
 * have inverted the editorial policy the weights exist to express.
 *
 * So the lead is drawn by SCORE across every category. The ranker has already
 * decided which item is best; the page just stops arguing with it. */
const CATEGORY_LABELS = {
  system_design: 'System Design',
  company_eng: 'Company Engineering',
  deep_dives: 'Deep Dives',
  devops_linux: 'DevOps & Linux',
  fintech: 'Fintech',
  gaming: 'Gaming',
  aggregators: 'Aggregators',
} as const;

type Category = keyof typeof CATEGORY_LABELS;
const CATEGORY_ORDER = Object.keys(CATEGORY_LABELS) as Category[];

const categoryOf = (p: (typeof posts)[number]) =>
  (p.data.category ?? 'aggregators') as Category;

/* Highest score first. `score` is the ranker's raw value, not the per-run
   normalised `heat`, so it is comparable across categories and across runs. */
const byScore = [...posts].sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0));

/* THE FOLD BELONGS TO THE DEPTH CATEGORIES.
 *
 * Drawing the hero by raw score across ALL categories was measured doing the
 * wrong thing: the hero and all four cards came back as Finextra payments
 * announcements. It is not a scoring bug. fintech, gaming and aggregators are
 * news-shaped and publish constantly, so at a 72h half-life their items are
 * always the freshest thing in the set — and "freshest" wins a cross-category
 * score comparison most of the time.
 *
 * That is the same volume problem the brief warned about, arriving at the one
 * place it does most damage. The page prints "depth outranks announcements" a
 * few inches lower; the fold has to mean it.
 *
 * The news categories are not demoted — they keep their own sections, at full
 * size. They just do not get to be the masthead. */
const DEPTH: Category[] = ['system_design', 'company_eng', 'deep_dives', 'devops_linux'];
const depthPool = byScore.filter((p) => DEPTH.includes(categoryOf(p)));

/* Fall back to the whole set only if the depth categories are empty, so a
   cold start still renders something rather than an empty state. */
const frontRunners = depthPool.length >= 5 ? depthPool : byScore;

/* One slot per source in the fold.
 *
 * Measured: the hero and all four cards came back as five consecutive Marc
 * Brooker posts. The ranker's per-source cap applies within a RUN, and these
 * five arrived across different runs, so nothing downstream stopped one author
 * monopolising the masthead. A newsletter whose front page is one blog is a
 * blog.
 *
 * Falls back to allowing repeats only if there are not five distinct sources,
 * so a thin day still fills the row. */
const pickDistinct = (pool: typeof posts, n: number) => {
  const seen = new Set<string>();
  const out: typeof posts = [];
  for (const post of pool) {
    if (seen.has(post.data.source)) continue;
    seen.add(post.data.source);
    out.push(post);
    if (out.length === n) break;
  }
  for (const post of pool) {
    if (out.length === n) break;
    if (!out.includes(post)) out.push(post);
  }
  return out;
};

const front = pickDistinct(frontRunners, 5);
const lead = front[0];
const cards = front.slice(1, 5);
const featured = new Set([lead, ...cards].filter(Boolean).map((p) => p.id));

/* Every category becomes a section — the table of contents the brief asked for.
   Featured posts are held out so the hero does not reappear three inches lower. */
const shelves = CATEGORY_ORDER.map((key) => ({
  key,
  label: CATEGORY_LABELS[key],
  items: posts.filter((p) => categoryOf(p) === key && !featured.has(p.id)).slice(0, 6),
})).filter((s) => s.items.length > 0);

/* The tail: everything not in the hero row and not shown on a shelf. */
const shelved = new Set(shelves.flatMap((s) => s.items.map((p) => p.id)));
const rest = byScore.filter((p) => !featured.has(p.id) && !shelved.has(p.id));

/* What the masthead counts. Every post is reachable from this page now, so the
   number is the whole collection rather than one category's share of it. */
const tech = posts;

const sources = [...new Set(posts.map((p) => p.data.source))];
/* When the SITE last rebuilt, from the most recent addedAt — not from the lead
 * post's pubDate. With the fold now drawn from the evergreen categories, the
 * lead's pubDate is its AUTHOR's date, and the masthead read "rebuilt 12 Oct
 * 2025" on a site that had rebuilt four minutes earlier. */
const lastAdded = posts
  .map((p) => p.data.addedAt ?? p.data.pubDate)
  .reduce((a, b) => (b > a ? b : a), new Date(0));
const lastRun =
  lastAdded.valueOf() > 0
    ? lastAdded.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })
    : '—';
---

<BaseLayout
  title="signal.log — an engineering newsletter, deterministically ranked"
  description="System design, company engineering, deep dives, devops, fintech and gaming — ranked by an open heuristic: per-category recency decay, source trust, topic relevance, deduplication. No model decides what appears."
>
  <!-- ── Masthead ─────────────────────────────────────────────── -->
  <header class="pb-5">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <Logo size={32} class="shrink-0 text-accent" />
        <h1 class="font-display text-[1.9rem] font-extrabold leading-none tracking-[-0.045em] text-ink sm:text-[2.4rem]">
          signal<span class="text-accent">.</span>log
        </h1>
      </div>
      <span class="hidden font-mono text-[0.68rem] uppercase tracking-[0.16em] text-faint sm:block">
        no model decides
      </span>
    </div>
  </header>

  <div class="masthead-rule flex flex-wrap items-center gap-x-5 gap-y-1 py-2 font-mono text-[0.68rem] text-faint">
    <span><span class="text-ink">{posts.length}</span> posts</span>
    <span class="opacity-40">/</span>
    <span><span class="text-ink">{sources.length}</span> sources</span>
    <span class="opacity-40">/</span>
    <span>rebuilt {lastRun}</span>
    <span class="ml-auto hidden text-accent sm:inline">recency · source weight · relevance</span>
  </div>

  <!-- ── The chart ────────────────────────────────────────────── -->
  <section id="feed" class="mt-9">
    {
      tech.length === 0 ? (
        <p class="py-16 text-center font-mono text-[0.85rem] text-faint">
          nothing ranked yet — the curator runs on a timer
        </p>
      ) : (
        <>
          <PostCard post={lead} index={0} variant="hero" />

          {cards.length > 0 && (
            <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {cards.map((post, i) => (
                <PostCard post={post} index={i + 1} variant="card" />
              ))}
            </div>
          )}

        </>
      )
    }
  </section>

  <!-- ── Shelves ──────────────────────────────────────────────── -->
  {
    shelves.length > 0 && (
      <section id="shelves" class="mt-16 border-t border-rule pt-4">
        <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-dim">
            every section
          </h2>
          <span class="font-mono text-[0.64rem] text-faint">
            ranked the same way &middot; depth outranks announcements
          </span>
        </div>

        <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
          {shelves.map((shelf) => (
            <div class="reveal">
              <h3
                class="font-mono text-[0.68rem] uppercase tracking-[0.14em]"
                style={`color: var(--cat)`}
                data-cat={shelf.key}
              >
                {shelf.label}
              </h3>
              <div class="mt-1">
                {shelf.items.map((post, i) => (
                  <PostCard post={post} index={i} variant="mini" />
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- ── The tail ─────────────────────────────────────────────── -->
  {/* Moved BELOW the sections. It was inside the chart block, between the hero
      row and the category sections, and with 158 entries it pushed every
      section off the bottom of the page — the table of contents was there and
      unreachable, which is the same failure the whole change was fixing, one
      level down. */}
  {
    rest.length > 0 && (
      <section id="tail" class="mt-16 border-t border-rule pt-4">
        <div class="mb-2 flex items-baseline justify-between">
          <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-dim">
            the rest of the chart
          </h2>
          <span class="font-mono text-[0.66rem] text-faint">{rest.length} entries</span>
        </div>
        <div class="grid gap-1 md:grid-cols-2 md:gap-x-4">
          {rest.map((post, i) => (
            <PostCard post={post} index={i + 5} variant="row" />
          ))}
        </div>
      </section>
    )
  }

  <!-- ── Colophon ─────────────────────────────────────────────── -->
  <section id="about" class="mt-16 border-t border-rule pt-8">
    <h2 class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-dim">How this works</h2>
    <div class="mt-5 grid gap-8 sm:grid-cols-3">
      {
        [
          { n: '01', t: 'Collect', d: 'A Python job pulls RSS from a fixed list of feeds every few hours.' },
          { n: '02', t: 'Rank', d: 'A deterministic heuristic scores each story, drops routine digests, collapses duplicates and caps any one feed.' },
          { n: '03', t: 'Publish', d: 'Survivors become Markdown, pushed to GitHub. Actions builds and deploys to Pages.' },
        ].map((s) => (
          <div>
            <span class="font-mono text-[0.7rem] text-accent">{s.n}</span>
            <h3 class="mt-1.5 font-display text-[1rem] font-bold text-ink">{s.t}</h3>
            <p class="mt-1.5 text-[0.92rem] leading-[1.6] text-dim">{s.d}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
