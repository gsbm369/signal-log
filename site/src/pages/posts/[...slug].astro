---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { labelOf } from '../../categories';
import { freshnessOf } from '../../freshness';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
};

const { post, posts } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, source, sourceUrl, tags, heat, readMinutes, image, imageAlt } = post.data;
const category = post.data.category ?? 'aggregators';
const label = labelOf(category);

const date = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const bars = Math.max(1, Math.min(5, Math.round((heat / 100) * 5)));
const initial = (source.trim()[0] ?? '·').toUpperCase();
/* Most entries' body IS the feed's summary, so a standfirst would print the
   same paragraph twice, one above the other. Only show it when it adds text. */
const norm = (t: string) => t.replace(/\s+/g, ' ').trim().toLowerCase();
const showStandfirst = !norm(post.body ?? '').startsWith(norm(description).slice(0, 80));
const sourceHost = sourceUrl ? new URL(sourceUrl).hostname.replace(/^www\./, '') : '';

/* More from the same section: same category, inside the freshness window,
   best score first. Never another category — the page keeps its colour. */
type Post = (typeof posts)[number];
const related = (posts as Post[])
  .filter((p) => p.id !== post.id && (p.data.category ?? 'aggregators') === category)
  .filter((p) => freshnessOf(p.data.pubDate) !== 'stale')
  .sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0))
  .slice(0, 3);
---

<BaseLayout title={`${title} — signal.log`} description={description} ogImage={image} cat={category}>
  <div class="progress" aria-hidden="true"></div>

  <article class="wrap pt-10 sm:pt-14">
    <div class="mx-auto max-w-[760px]">
      <nav class="flex items-center gap-2 font-mono text-[0.74rem] text-faint" aria-label="Breadcrumb">
        <a href="/" class="text-faint no-underline transition-colors hover:text-ink">signal.log</a>
        <span aria-hidden="true">/</span>
        <a href={`/#${category}`} class="kicker no-underline">{label}</a>
      </nav>

      <header class="mt-7">
        <h1 class="article-title">{title}</h1>
        {showStandfirst && <p class="standfirst mt-5 text-[1.2rem] sm:text-[1.35rem]">{description}</p>}

        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3 border-y border-rule py-4">
          <span class="avatar !h-9 !w-9 !text-[0.95rem]">{initial}</span>
          <div class="leading-tight">
            <p class="text-[0.92rem] font-semibold text-ink">{source}</p>
            <p class="mt-0.5 font-mono text-[0.7rem] text-faint">
              <time datetime={pubDate.toISOString()}>{date}</time> &middot; {readMinutes} min read
            </p>
          </div>
          <span class="ml-auto flex items-center gap-2 font-mono text-[0.68rem] text-faint" title={`Heat score ${heat}/100`}>
            heat
            <span class="heat" data-bars={bars}><i /><i /><i /><i /><i /></span>
          </span>
        </div>
      </header>
    </div>

    {
      image && (
        <figure class="figure mx-auto mt-10 max-w-[980px]">
          <div class="shot shot--wide overflow-hidden rounded-[20px] border border-rule">
            <img src={image} alt={imageAlt ?? ''} loading="eager" decoding="async" width="1280" height="720" />
          </div>
          {imageAlt && <figcaption class="mt-3 text-center font-serif text-[0.92rem] italic text-faint">{imageAlt}</figcaption>}
        </figure>
      )
    }

    <div class="mx-auto max-w-[760px]">
      <div class="prose mt-10">
        <Content />
      </div>

      {
        sourceUrl && (
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="source-card mt-12">
            <div class="min-w-0">
              <p class="kicker">Read the full story</p>
              <p class="mt-1.5 font-display text-[1.15rem] font-bold tracking-[-0.02em] text-ink">Continue on {source}</p>
              <p class="mt-1 truncate font-mono text-[0.72rem] text-faint">{sourceHost}</p>
            </div>
            <span class="arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </span>
          </a>
        )
      }

      {
        tags.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-2">
            {tags.map((tag) => <span class="tag">#{tag}</span>)}
          </div>
        )
      }
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="wrap mt-20">
        <h2 class="eyebrow mb-6">More in {label}</h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p, i) => (
            <PostCard post={p} index={i} variant="feature" section="related" />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
