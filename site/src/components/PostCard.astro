---
import { freshnessOf } from '../freshness';
import { labelOf } from '../categories';
import type { CollectionEntry } from 'astro:content';

/*
  Five densities off one component.

    hero     the lead story — 16:9 image, big headline, serif standfirst
    card     ranks 2-5      — 16:10 image, headline, standfirst, byline
    feature  a chapter's opener — the first story in each section
    item     a chapter's list   — headline, standfirst, thumbnail at the side
    row      the tail           — rank, thumbnail, headline, meta

  Every variant handles a missing image, and for this publication that is the
  COMMON case, not the edge: Marc Brooker, Dan Luu and jvns.ca ship no images at
  all. The fallback is typographic — the source's name set large on the
  category colour — so the absence is a deliberate style rather than a defect.

  Every variant carries data-published / data-freshness / data-section and, for
  week-old stories, the visible data-label="this-week" chip. The publish gate
  parses exactly these; see curator/check_freshness.py.
*/
interface Props {
  post: CollectionEntry<'posts'>;
  index: number;
  variant?: 'hero' | 'card' | 'feature' | 'item' | 'row' | 'mini';
  /* Which part of the page rendered this card — "fold", a category slug, or
     "tail". Carried into the HTML so the publish gate can report the oldest
     rendered age per section without re-deriving the layout. */
  section?: string;
}

const { post, index, variant: requested = 'card', section = 'unassigned' } = Astro.props;
// `mini` was the old name for a chapter list entry.
const variant = requested === 'mini' ? 'item' : requested;
const { title, description, pubDate, source, heat, readMinutes, image, imageAlt } = post.data;
const category = post.data.category ?? 'aggregators';
const label = labelOf(category);

const num = String(index + 1).padStart(2, '0');
const href = `/posts/${post.id}/`;
const iso = pubDate.toISOString();
const dateShort = pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
const hot = heat >= 90;
const alt = imageAlt ?? '';
const initial = (source.trim()[0] ?? '·').toUpperCase();

/* The publish gate parses these attributes: a card over seven days old fails
   the publish, and a "week" card without the visible label fails it too. */
const freshness = freshnessOf(pubDate);
---

{
  variant === 'hero' && (
    <article class="card lead reveal" data-cat={category} data-published={iso} data-freshness={freshness} data-section={section}>
      <a href={href} class="hit" aria-label={title} />

      <div class={`shot shot--wide${image ? '' : ' shot--empty'}`}>
        <span class="rank-badge"><span class="dot" />Top story</span>
        {image ? <img src={image} alt={alt} loading="eager" decoding="async" fetchpriority="high" width="1280" height="720" /> : <span class="tile-type tile-type--hero">{source}</span>}
      </div>

      <div class="p-6 sm:p-8">
        <div class="mb-4 flex flex-wrap items-center gap-2">
          <span class="kicker">{label}</span>
          {hot && <span class="chip chip--hot">hot</span>}
          {freshness === 'week' && <span class="chip chip--week" data-label="this-week">this week</span>}
        </div>

        <h2 class="card-title lead-title">{title}</h2>

        <p class="standfirst mt-4 max-w-[62ch]">{description}</p>

        <div class="meta mt-6">
          <span class="avatar">{initial}</span>
          <span class="src">{source}</span>
          <span class="sep">·</span>
          <time datetime={iso}>{dateShort}</time>
          <span class="sep">·</span>
          <span>{readMinutes} min read</span>
        </div>
      </div>
    </article>
  )
}

{
  (variant === 'card' || variant === 'feature') && (
    <article class="card reveal flex flex-col" data-cat={category} data-published={iso} data-freshness={freshness} data-section={section}>
      <a href={href} class="hit" aria-label={title} />

      <div class={`shot ${variant === 'feature' ? 'shot--wide' : 'shot--card'}${image ? '' : ' shot--empty'}`}>
        {image ? <img src={image} alt={alt} loading="lazy" decoding="async" width="800" height="500" /> : <span class="tile-type">{source}</span>}
      </div>

      <div class={`flex flex-1 flex-col ${variant === 'feature' ? 'p-6' : 'p-5'}`}>
        <div class="mb-2.5 flex flex-wrap items-center gap-2">
          {variant === 'card' && <span class="rank text-[1.05rem]">{num}</span>}
          <span class="kicker">{label}</span>
          {hot && <span class="chip chip--hot">hot</span>}
        </div>
        <h3 class={`card-title font-display font-bold leading-[1.15] tracking-[-0.025em] text-ink ${variant === 'feature' ? 'text-[1.45rem] sm:text-[1.6rem]' : 'text-[1.12rem]'}`}>
          {title}
        </h3>
        <p class={`mt-2.5 font-serif leading-[1.5] text-dim ${variant === 'feature' ? 'line-clamp-3 text-[1.05rem]' : 'line-clamp-2 text-[0.98rem]'}`}>{description}</p>
        <div class="meta mt-auto pt-4">
          <span class="src">{source}</span>
          <span class="sep">·</span>
          <time datetime={iso}>{dateShort}</time>
          {freshness === 'week' && <span class="chip chip--week" data-label="this-week">this week</span>}
        </div>
      </div>
    </article>
  )
}

{
  variant === 'item' && (
    <article class="item" data-cat={category} data-published={iso} data-freshness={freshness} data-section={section}>
      <a href={href} class="hit" aria-label={title} />
      <div class="min-w-0 flex-1">
        <h4 class="card-title font-display text-[1.02rem] font-bold leading-[1.25] tracking-[-0.02em] text-ink">
          {title}
        </h4>
        <p class="mt-1.5 line-clamp-2 font-serif text-[0.95rem] leading-[1.45] text-dim">{description}</p>
        <div class="meta mt-2">
          <span class="src">{source}</span>
          <span class="sep">·</span>
          <time datetime={iso}>{dateShort}</time>
          {freshness === 'week' && <span class="chip chip--week" data-label="this-week">this week</span>}
          {hot && <span class="chip chip--hot">hot</span>}
        </div>
      </div>
      {image && (
        <div class="shot shot--thumb">
          <img src={image} alt={alt} loading="lazy" decoding="async" width="224" height="160" />
        </div>
      )}
    </article>
  )
}

{
  variant === 'row' && (
    <article class="row" data-cat={category} data-published={iso} data-freshness={freshness} data-section={section}>
      <a href={href} class="hit" aria-label={title} />

      <span class="row-rank">{num}</span>

      <div class={`shot shot--thumb${image ? '' : ' shot--empty'}`}>
        {image ? <img src={image} alt={alt} loading="lazy" decoding="async" width="224" height="160" /> : <span>{initial}</span>}
      </div>

      <div class="min-w-0 flex-1">
        <span class="kicker text-[0.6rem]">{label}</span>
        <h3 class="card-title mt-1 font-display text-[0.98rem] font-bold leading-[1.28] tracking-[-0.015em] text-ink">
          {title}
        </h3>
        <div class="meta mt-1.5">
          <span class="src">{source}</span>
          <span class="sep">·</span>
          <time datetime={iso}>{dateShort}</time>
          {freshness === 'week' && <span class="chip chip--week" data-label="this-week">this week</span>}
          {hot && <span class="chip chip--hot">hot</span>}
        </div>
      </div>
    </article>
  )
}
