---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  index: number;
}

const { post, index } = Astro.props;
const { title, description, pubDate, source, tags, heat, readMinutes } = post.data;

const date = pubDate.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});

// Heat meter: 5 bars, filled proportionally to the score Claude assigned.
const bars = Math.max(1, Math.round((heat / 100) * 5));
const num = String(index + 1).padStart(2, '0');
---

<article class="panel panel-hover reveal group relative overflow-hidden p-7 sm:p-8">
  <a href={`/posts/${post.id}/`} class="absolute inset-0 z-10" aria-label={title}></a>

  <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[0.75rem]">
    <span class="text-accent">{num}</span>
    <span class="text-faint">{date}</span>
    <span class="text-faint">&middot;</span>
    <span class="text-dim">{source}</span>
    <span class="text-faint">&middot;</span>
    <span class="text-faint">{readMinutes} min</span>

    <span class="ml-auto flex items-center gap-[3px]" title={`Heat score ${heat}/100`}>
      {
        Array.from({ length: 5 }).map((_, i) => (
          <span
            class="block h-[10px] w-[3px] rounded-full"
            style={`background:${i < bars ? 'var(--color-accent)' : 'var(--color-faint)'};opacity:${i < bars ? 1 : 0.45}`}
          />
        ))
      }
    </span>
  </div>

  <h2 class="font-head text-[1.22rem] font-semibold leading-snug tracking-[-0.4px] text-ink transition-colors duration-300 group-hover:text-accent sm:text-[1.35rem]">
    {title}
  </h2>

  <p class="mt-3 text-[0.94rem] leading-[1.7] text-dim">
    {description}
  </p>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    {
      tags.slice(0, 4).map((tag) => (
        <span class="rounded-full border border-line px-[0.6rem] py-[0.2rem] font-mono text-[0.68rem] lowercase text-faint transition-colors duration-300 group-hover:border-accent/30 group-hover:text-dim">
          {tag}
        </span>
      ))
    }
    <span class="ml-auto font-mono text-[0.75rem] text-faint transition-all duration-300 group-hover:translate-x-1 group-hover:text-accent">
      read &rarr;
    </span>
  </div>
</article>
