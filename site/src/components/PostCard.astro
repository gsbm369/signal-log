---
import type { CollectionEntry } from 'astro:content';

/*
  Chart entries. One column at every width — the layout does not fork for
  mobile, it only changes scale, which is why it survives 360px.

    lead   the number one — the rank set enormous, the headline under it
    major  ranks 2-5      — rank, headline, one line
    minor  the tail       — rank, headline, meta
    mini   shelves        — markets / gaming / world, headline only
*/
interface Props {
  post: CollectionEntry<'posts'>;
  index: number;
  variant?: 'lead' | 'major' | 'minor' | 'mini';
}

const { post, index, variant = 'minor' } = Astro.props;
const { title, description, pubDate, source, heat, readMinutes } = post.data;

const num = String(index + 1).padStart(2, '0');
const href = `/posts/${post.id}/`;
const iso = pubDate.toISOString();
const dateShort = pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
// Bucketed to tens so the width comes from a CSS rule rather than an
// inline style — the page ships zero style attributes and the CSP
// keeps its tightened style-src.
const pct = Math.min(100, Math.max(10, Math.round(heat / 10) * 10));
---

{
  variant === 'lead' && (
    <article class="entry entry--lead reveal group">
      <a href={href} class="absolute inset-0 z-10" aria-label={title} />

      <span class="rank block">{num}</span>

      <div class="meta">
        <span class="src">{source}</span>
        <span class="sep">/</span>
        <time datetime={iso}>{dateShort}</time>
        <span class="sep">/</span>
        <span>{readMinutes} min</span>
      </div>

      <h2 class="entry-title font-display text-[2rem] font-extrabold leading-[1.04] tracking-[-0.035em] text-ink sm:text-[3.1rem]">
        {title}
      </h2>

      <p class="max-w-[58ch] text-[1.02rem] leading-[1.65] text-dim sm:text-[1.12rem]">
        {description}
      </p>
    </article>
  )
}

{
  variant === 'major' && (
    <article class="entry entry--major reveal group">
      <a href={href} class="absolute inset-0 z-10" aria-label={title} />

      <span class="rank pt-1">{num}</span>

      <div class="min-w-0">
        <h3 class="entry-title font-display text-[1.18rem] font-bold leading-[1.18] tracking-[-0.02em] text-ink sm:text-[1.55rem]">
          {title}
        </h3>
        <p class="mt-2 line-clamp-2 max-w-[62ch] text-[0.94rem] leading-[1.6] text-dim">
          {description}
        </p>
        <div class="meta mt-2.5">
          <span class="src">{source}</span>
          <span class="sep">/</span>
          <time datetime={iso}>{dateShort}</time>
          <span class="sep">/</span>
          <span>{readMinutes} min</span>
        </div>
      </div>
    </article>
  )
}

{
  variant === 'minor' && (
    <article class="entry entry--minor reveal group">
      <a href={href} class="absolute inset-0 z-10" aria-label={title} />

      <span class="rank pt-[0.15rem]">{num}</span>

      <div class="min-w-0">
        <h3 class="entry-title font-display text-[0.98rem] font-semibold leading-[1.3] tracking-[-0.015em] text-ink sm:text-[1.08rem]">
          {title}
        </h3>
        <div class="meta mt-1.5">
          <span class="src">{source}</span>
          <span class="sep">/</span>
          <time datetime={iso}>{dateShort}</time>
        </div>
      </div>

      <span class="heat-bar mt-2 hidden sm:block" title={`Heat ${heat}/100`}>
        <span data-heat={pct} />
      </span>
    </article>
  )
}

{
  variant === 'mini' && (
    <article class="group relative border-t border-rule-soft py-3">
      <a href={href} class="absolute inset-0 z-10" aria-label={title} />
      <h3 class="entry-title font-display text-[0.9rem] font-semibold leading-[1.35] text-ink">
        {title}
      </h3>
      <div class="meta mt-1.5">
        <span class="src">{source}</span>
        <span class="sep">/</span>
        <time datetime={iso}>{dateShort}</time>
      </div>
    </article>
  )
}
