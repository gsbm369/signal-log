---
import type { CollectionEntry } from 'astro:content';

/*
  Four densities off one component.

    hero   the number one — 16:9 image, big headline, standfirst
    card   ranks 2-5      — 3:2 image, headline, meta
    row    the tail       — 76px thumbnail, headline, heat
    mini   shelves        — headline and source only

  Every variant handles a missing image, and for this publication that is the
  COMMON case, not the edge: Marc Brooker, Dan Luu and jvns.ca ship no images at
  all, and they are the sources the front page leads on. A fold of five evergreen
  posts was five flat rectangles with a rank number in the middle.

  A rank badge on a flat colour reads as an image that failed to load. The
  fallback is now typographic — the headline set large on the category colour —
  so the absence is a deliberate style rather than a defect. No image is fetched
  or generated for text-only sources; there is nothing to fetch.
*/
interface Props {
  post: CollectionEntry<'posts'>;
  index: number;
  variant?: 'hero' | 'card' | 'row' | 'mini';
}

const { post, index, variant = 'card' } = Astro.props;
const { title, description, pubDate, source, heat, readMinutes, image, imageAlt } = post.data;
const category = post.data.category ?? 'aggregators';

const num = String(index + 1).padStart(2, '0');
const href = `/posts/${post.id}/`;
const iso = pubDate.toISOString();
const dateShort = pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
// Bucketed to tens so width comes from a CSS rule, keeping the page free of
// style attributes and the CSP's style-src tight.
const pct = Math.min(100, Math.max(10, Math.round(heat / 10) * 10));
const hot = heat >= 90;
const alt = imageAlt ?? '';
---

{
  variant === 'hero' && (
    <article class="card reveal" data-cat={category}>
      <a href={href} class="absolute inset-0 z-10" aria-label={title} />

      <div class={`shot shot--wide${image ? '' : ' shot--empty'}`}>
        <span class="rank-badge rank-badge--lead">{num}</span>
        {image ? <img src={image} alt={alt} loading="eager" decoding="async" width="1280" height="720" /> : <span class="tile-type tile-type--hero">{title}</span>}
      </div>

      <div class="p-5 sm:p-7">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span class="chip">{category}</span>
          {hot && <span class="chip chip--hot">hot</span>}
          <span class="meta ml-auto">
            <span class="src">{source}</span>
            <span class="sep">/</span>
            <time datetime={iso}>{dateShort}</time>
            <span class="sep">/</span>
            <span>{readMinutes} min</span>
          </span>
        </div>

        <h2 class="card-title font-display text-[1.55rem] font-extrabold leading-[1.12] tracking-[-0.03em] text-ink sm:text-[2.15rem]">
          {title}
        </h2>

        <p class="mt-3 max-w-[60ch] text-[0.97rem] leading-[1.65] text-dim">{description}</p>
      </div>
    </article>
  )
}

{
  variant === 'card' && (
    <article class="card reveal flex flex-col" data-cat={category}>
      <a href={href} class="absolute inset-0 z-10" aria-label={title} />

      <div class={`shot shot--card${image ? '' : ' shot--empty'}`}>
        <span class="rank-badge">{num}</span>
        {image ? <img src={image} alt={alt} loading="lazy" decoding="async" width="600" height="400" /> : <span class="tile-type">{title}</span>}
      </div>

      <div class="flex flex-1 flex-col p-4">
        <h3 class="card-title font-display text-[1.02rem] font-bold leading-[1.22] tracking-[-0.02em] text-ink">
          {title}
        </h3>
        <p class="mt-2 line-clamp-2 text-[0.85rem] leading-[1.55] text-dim">{description}</p>
        <div class="meta mt-3 pt-1">
          <span class="src">{source}</span>
          <span class="sep">/</span>
          <time datetime={iso}>{dateShort}</time>
        </div>
      </div>
    </article>
  )
}

{
  variant === 'row' && (
    <article class="row group" data-cat={category}>
      <a href={href} class="absolute inset-0 z-10" aria-label={title} />

      <span class="row-rank">{num}</span>

      <div class={`shot shot--thumb${image ? '' : ' shot--empty'}`}>
        {image ? <img src={image} alt={alt} loading="lazy" decoding="async" width="152" height="116" /> : <span>{num}</span>}
      </div>

      <div class="min-w-0 flex-1">
        <h3 class="card-title font-display text-[0.94rem] font-semibold leading-[1.3] tracking-[-0.015em] text-ink">
          {title}
        </h3>
        <div class="meta mt-1.5">
          <span class="src">{source}</span>
          <span class="sep">/</span>
          <time datetime={iso}>{dateShort}</time>
          {hot && <span class="chip chip--hot ml-1">hot</span>}
        </div>
        <span class="heat-bar mt-2 max-w-[6rem]" title={`Heat ${heat}/100`}>
          <span data-heat={pct} />
        </span>
      </div>
    </article>
  )
}

{
  variant === 'mini' && (
    <article class="row group !px-2 !py-2.5" data-cat={category}>
      <a href={href} class="absolute inset-0 z-10" aria-label={title} />
      <div class="min-w-0 flex-1">
        <h3 class="card-title font-display text-[0.87rem] font-semibold leading-[1.35] text-ink">
          {title}
        </h3>
        <div class="meta mt-1">
          <span class="src">{source}</span>
          <span class="sep">/</span>
          <time datetime={iso}>{dateShort}</time>
        </div>
      </div>
    </article>
  )
}
