[Unit]
Description=Run the signal.log publish cycle every 6 hours
Documentation=https://github.com/gsbm369/signal-log

[Timer]
# 05:47, not 06:17 (2026-11-05). social-agent starts its morning curation at
# 06:10 local and delivers all six reels by 07:10; at :17 every morning read
# the 00:17 feed, six hours old. :47 leaves ~20 min for the cycle (~90 s) and
# the Pages deploy. Every run moved, not one added: same 6-hour spacing.
OnCalendar=*-*-* 05,11,17,23:47:00
# THE REASON THIS IS A TIMER AND NOT A CRON ENTRY.
#
# This guest runs on a memory-constrained Hyper-V host and has been suspended
# for 20+ hours at a stretch. Vixie cron fires on wall-clock minutes: after a
# resume it simply waits for the next matching minute, and every window that
# elapsed while the VM was saved is lost silently. That cost ~21 hours of
# publishing, and nothing in the system could tell the difference between
# "cron ran and failed" and "cron never ran" until the metrics were queried.
#
# Persistent=true records the last run on disk and fires IMMEDIATELY on resume
# if a window was missed, so a suspended VM costs one delayed cycle instead of
# every cycle it slept through.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
