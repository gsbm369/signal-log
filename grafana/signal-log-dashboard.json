{
  "title": "signal.log \u2014 curator",
  "uid": "signal-log-curator",
  "tags": [
    "signal-log",
    "homelab",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Loki datasource",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "constant",
        "query": "signal-log",
        "current": {
          "text": "signal-log",
          "value": "signal-log"
        },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Problem cycles (range)",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"$job\"} | json | cycle_status != \"ok\" [$__range])) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "description": "Cycles in the selected range whose status was not \"ok\". Zero is the healthy state."
    },
    {
      "type": "stat",
      "title": "Cycles run (range)",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"$job\"} | json | cycle_status != \"\" [$__range])) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Spend (range)",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(sum_over_time({job=\"$job\"} | json | unwrap cost_usd [$__range]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Cycles by outcome (range)",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{cycle_status}}",
          "expr": "sum by (cycle_status) (count_over_time({job=\"$job\"} | json | cycle_status != \"\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background_solid",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Posts live",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "max(last_over_time({job=\"$job\"} | json | posts_live != \"\" | unwrap posts_live [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cycle outcomes over time",
      "description": "ok / degraded / failed / skipped. A run that never fires shows as a gap.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{cycle_status}}",
          "expr": "sum by (cycle_status) (count_over_time({job=\"$job\"} | json | cycle_status != \"\" [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "degraded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "skipped"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Cost per run (USD)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "cost",
          "expr": "sum(sum_over_time({job=\"$job\"} | json | unwrap cost_usd [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Articles: fetched / new / kept",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "fetched",
          "expr": "sum(sum_over_time({job=\"$job\"} | json | unwrap articles_fetched [$__auto]))"
        },
        {
          "refId": "B",
          "legendFormat": "new",
          "expr": "sum(sum_over_time({job=\"$job\"} | json | unwrap articles_new [$__auto]))"
        },
        {
          "refId": "C",
          "legendFormat": "kept",
          "expr": "sum(sum_over_time({job=\"$job\"} | json | unwrap articles_kept [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens per run",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "input",
          "expr": "sum(sum_over_time({job=\"$job\"} | json | unwrap input_tokens [$__auto]))"
        },
        {
          "refId": "B",
          "legendFormat": "output",
          "expr": "sum(sum_over_time({job=\"$job\"} | json | unwrap output_tokens [$__auto]))"
        },
        {
          "refId": "C",
          "legendFormat": "cache read",
          "expr": "sum(sum_over_time({job=\"$job\"} | json | unwrap cache_read_tokens [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Feed health (failed feeds per run)",
      "description": "A feed that rots shows up here instead of being buried in a warning line.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "ok",
          "expr": "sum(sum_over_time({job=\"$job\"} | json | unwrap feeds_ok [$__auto]))"
        },
        {
          "refId": "B",
          "legendFormat": "failed",
          "expr": "sum(sum_over_time({job=\"$job\"} | json | unwrap feeds_failed [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "logs",
      "title": "Problem cycles (not ok)",
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 18
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"$job\"} | json | cycle_status != \"ok\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "All cycle records",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"$job\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
