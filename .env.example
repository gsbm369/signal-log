# ---------------------------------------------------------------- secrets
# Anthropic API key used by curator/curate.py
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------- site
# Host port nginx binds. The reverse proxy talks to the container directly.
BLOG_PORT=8080
# Canonical origin, used for RSS links. Set to the public hostname.
SITE_URL=http://localhost:8080

# ------------------------------------------------------------------ model
# Curation model. Cost estimates in curate.py cover opus-5, sonnet-5, haiku-4-5.
CURATOR_MODEL=claude-opus-5

# ------------------------------------------------------------ observability
# Loki push endpoint, reachable from the builder container. Blank disables shipping.
LOKI_URL=http://loki:3100
LOKI_JOB=signal-log
LOKI_HOST_LABEL=

# --------------------------------------------------------------- portability
# UID/GID that owns the bind mounts. Written by ansible/deploy.yml from the
# deploying user, so this project is not tied to uid 1000 on one machine.
BLOG_UID=1000
BLOG_GID=1000
# Shared docker network that Nginx Proxy Manager and Loki live on.
PROXY_NETWORK=proxy-stack_proxy-net

# ------------------------------------------------------------------- misc
TZ=Asia/Jerusalem
# Number of past releases kept under public_html/releases for rollback.
KEEP_RELEASES=5
