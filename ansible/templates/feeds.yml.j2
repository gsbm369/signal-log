# MANAGED BY ANSIBLE — ansible/templates/feeds.yml.j2
# Local edits are overwritten on the next deploy. Change `blog_feeds` and the
# cost-control vars in ansible/deploy.yml (or -e on the command line) instead.
#
# RSS sources the curator polls each run.
# `weight` nudges how many candidates are taken from each feed.
feeds:
{% for f in blog_feeds %}
  - name: {{ f.name }}
    url: {{ f.url }}
    weight: {{ f.weight | default(1) }}
{% endfor %}

settings:
  # Summarizer backend: none | ollama | anthropic
  #   none      feed's own <description>. No model, no key, $0. DEFAULT.
  #   ollama    local model on the Docker host. Free, self-hosted.
  #   anthropic claude-haiku-4-5 via the Batch API (half price).
  # Ranking and selection are deterministic in all three — see curator/ranker.py.
  summarizer: {{ summarizer_backend }}
  # Max articles any single feed may contribute to one run.
  per_source_cap: {{ per_source_cap }}
  # Max candidate articles handed to Claude in one run — the input-token driver.
  max_candidates: {{ max_candidates }}
  # How many stories Claude is asked to publish per run — the output-token driver.
  publish_count: {{ publish_count }}
  # Keep at most this many posts on the site; oldest are pruned.
  max_posts: {{ max_posts }}
  # Skip anything older than this many hours.
  max_age_hours: {{ max_age_hours }}
