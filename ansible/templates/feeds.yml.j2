# GENERATED BY ANSIBLE — edits here are erased on deploy.
#
# Source of truth: ansible/templates/feeds.yml.j2 and the vars it reads
# (`blog_feeds`, `scoring_categories`, and the cost-control vars) in
# ansible/deploy.yml. Change those, commit, then run the playbook so this
# generated file matches the repo.
#
# RSS sources the curator polls each run.
#   fetch            how many entries to pull from this feed. Per SOURCE because
#                    archives differ by two orders of magnitude: Marc Brooker
#                    exposes 163 items, Brendan Gregg 10.
#   weight           ranking multiplier, clamped to [0.60, 1.30]. It breaks ties
#                    between comparably relevant stories; it must not lift an
#                    irrelevant one to the top.
#   half_life_hours  OPTIONAL. Overrides the category's decay curve for this one
#                    source. Cadence and subject are independent — see the
#                    scoring block below.
#   ingest_days      OPTIONAL. Overrides the category's ingest window. Required
#                    alongside a half_life_hours override whenever the source is
#                    slower than its category, or the item is discarded at fetch
#                    time and the curve is never consulted.
feeds:
{% for f in blog_feeds %}
  - name: {{ f.name }}
    url: {{ f.url }}
    category: {{ f.category }}
    weight: {{ f.weight | default(1.0) }}
    fetch: {{ f.fetch | default(15) }}
{% if f.half_life_hours is defined %}
    half_life_hours: {{ f.half_life_hours }}
{% endif %}
{% if f.ingest_days is defined %}
    ingest_days: {{ f.ingest_days }}
{% endif %}
{% endfor %}

# --------------------------------------------------------------------------- #
# Scoring policy, per category.
# --------------------------------------------------------------------------- #
#
# half_life_hours  EDITORIAL FRESHNESS. The recency decay halves a score every
#                  this many hours. This — not the ingest window — is what keeps
#                  the page current, and it demotes a stale item instead of
#                  deleting it, so an evergreen piece can still win when nothing
#                  fresher is competing.
#
# ingest_days      INGEST WINDOW ONLY: how far back we bother parsing. It is not
#                  a freshness policy. It exists so a ten-year archive is not
#                  re-parsed every four hours, and so a multi-day outage still
#                  catches up. Set it wide and let the curve do the editing.
#
# retention_days   How long the seen-store remembers a published item.
#                  `null` means FOREVER and is the point of the evergreen
#                  categories: 45 days is a memory bound for news, but applied
#                  to deep_dives it is an instruction to re-run the same essay
#                  every six weeks.
#
# cap              Items this category may contribute to one issue.
scoring:
  categories:
{% for cat, pol in scoring_categories.items() %}
    {{ cat }}:
      half_life_hours: {{ pol.half_life_hours }}
      ingest_days: {{ pol.ingest_days }}
      retention_days: {{ pol.retention_days if pol.retention_days is not none else 'null' }}
      cap: {{ pol.cap }}
{% endfor %}

settings:
  # Summarizer backend: none | ollama | anthropic
  #   none      feed's own <description>. No model, no key, $0. DEFAULT.
  #   ollama    local model on the Docker host. Free, self-hosted.
  #   anthropic claude-haiku-4-5 via the Batch API (half price).
  # Ranking and selection are deterministic in all three — see curator/ranker.py.
  summarizer: {{ summarizer_backend }}
  # Max articles any single feed may contribute to one run.
  per_source_cap: {{ per_source_cap }}
  # Apply this project's extra noise patterns (listicles, deals, Ask HN) on top
  # of the ported list. The ported list alone is tuned for LWN/vendor feeds.
  extra_noise_filter: {{ extra_noise_filter | lower }}
  # Max candidate articles per category, cut by SCORE. Cutting by date here
  # re-imposed recency after the category split — the axis the per-category
  # half-life exists to remove.
  max_candidates: {{ max_candidates }}
  # Fallback publish count for a category the scoring block does not mention.
  publish_count: {{ publish_count }}
  # Keep at most this many posts on the site; oldest are pruned.
  max_posts: {{ max_posts }}
